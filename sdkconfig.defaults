# 新生成的 ESP-IDF 配置沿用开发板已验证的四线 QIO 闪存模式。
# ESP-IDF 派生的 CONFIG_ESPTOOLPY_FLASHMODE 字符串仍为 "dio"，
# 因为 esptool 先按 DIO 加载引导程序，再由引导程序启用 QIO。
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 当前 ESP32-S3 N16R8 底板：16 MB QIO Flash + 8 MB Octal PSRAM。
# 设备配置依赖 PSRAM 保存自动回合和插话缓存；其他规格请按实际硬件调整。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_WS_TRANSPORT=y
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# PSRAM 可用时，将大于 1 KiB 的普通缓冲放到 PSRAM；
# 为任务栈、网络和 DMA 分配保留一部分只能使用的内部内存。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_VOICE_REALTIME_ENABLED=y
CONFIG_VOICE_LOCAL_FRONTEND_ENABLED=y
CONFIG_VOICE_LOCAL_BUTTONS_ENABLED=y
CONFIG_VOICE_BUTTON_FIRST_GPIO=7
CONFIG_VOICE_BUTTON_SECOND_GPIO=3
CONFIG_VOICE_BUTTON_ACTIVE_LOW=y
CONFIG_VOICE_AUDIO_SERVER_URL="http://192.168.1.10:8000"
CONFIG_VOICE_SERVER_PROFILE="realtime_default"
CONFIG_VOICE_WS_SERVER_URL=""
CONFIG_VOICE_CODEC_OPUS=y
CONFIG_VOICE_PLAYBACK_VOLUME=40
CONFIG_VOICE_MIC_GAIN=1
# CONFIG_VOICE_WIFI_POWER_SAVE is not set
CONFIG_VOICE_UPLINK_SEND_TIMEOUT_MS=200
CONFIG_VOICE_DEVICE_AUTOSTART=y
# CONFIG_VOICE_SERIAL_COMMANDS_ENABLED is not set
CONFIG_VOICE_PLAYBACK_REFERENCE_ENABLED=y
CONFIG_VOICE_REFERENCE_ALIGNMENT_ENABLED=y
CONFIG_VOICE_AEC_OBSERVATION_ENABLED=y
CONFIG_VOICE_AEC_REFERENCE_DELAY_MS=0
CONFIG_VOICE_AUTO_LISTEN_ENABLED=y
CONFIG_VOICE_AUTO_PREROLL_MS=400
CONFIG_VOICE_AUTO_START_CONFIRM_MS=160
CONFIG_VOICE_AUTO_START_MIN_AC_RMS=80
CONFIG_VOICE_AUTO_SILENCE_MS=700
CONFIG_VOICE_AUTO_HANDSHAKE_MS=2000
CONFIG_VOICE_BARGE_IN_OBSERVATION_ENABLED=y
CONFIG_VOICE_BARGE_IN_CONFIRM_MS=200
CONFIG_VOICE_BARGE_IN_MIN_AC_RMS=80
CONFIG_VOICE_BARGE_IN_ENABLED=y
# CONFIG_VOICE_AFE_SIGNAL_PROBE_BOOT is not set
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
# 保留 ESP-SR 单麦 AEC 使用的 WebRTC 降噪配置。
CONFIG_SR_NSN_WEBRTC=y
# CONFIG_SR_VADN_WEBRTC is not set
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
